// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model CatalogGame {
    id        Int            @id @default(autoincrement())
    slug      String         @unique
    name      String
    currency  String
    position  Int
    offers    CatalogOffer[]

    @@unique([position])
}

model CatalogOffer {
    id       Int         @id @default(autoincrement())
    label    String
    price    Int
    position Int
    gameId   Int
    game     CatalogGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

    @@unique([gameId, position])
}

model PopularDeal {
    id          Int      @id @default(autoincrement())
    gameSlug    String
    title       String
    dealName    String
    badge       String
    instant     Boolean  @default(true)
    soldCount   String
    oldPrice    Int
    price       Int
    image       String
    position    Int      @default(0)
}
